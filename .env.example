# Copy this file to .env and fill in the values

PORT=3500

# Frontend URL(s) allowed to call the API with cookies, comma-separated
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Set to "production" when deployed (enables secure cookies, disables dev OTP logging)
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT signing secret: use a long random string
SECRET_KEY=

# Gmail account used to send OTP emails (EMAIL_PASS is a Gmail app password).
# If left empty in development, the OTP is printed in the server console instead.
EMAIL=
EMAIL_PASS=

# ImageKit private key (image uploads) and URL endpoint (needed to download
# encrypted chat attachments, which are stored as private files)
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_imagekit_id>

# ─── Encrypted chat ──────────────────────────────────────────────────────────
# Chat data lives in a separate database. Leave CHAT_MONGODB_URI empty to use the
# same cluster as MONGODB with a different database name (CHAT_DB_NAME).
CHAT_MONGODB_URI=
CHAT_DB_NAME=pinclone_chat
# Domain part of the Matrix-style ids used by the encryption library. Changing it
# later invalidates every existing chat device, so pick it once.
CHAT_SERVER_NAME=pinclone.local
